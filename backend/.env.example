# Database
DATABASE_URL=postgresql+asyncpg://minologue:minologue_pass@postgres:5432/minologue_db

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# S3 (MinIO)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=minologue-photos
S3_REGION=us-east-1

# App
PROJECT_NAME=Minologue
DEBUG=True
LOG_LEVEL=INFO
